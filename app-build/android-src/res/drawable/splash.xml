<?xml version="1.0" encoding="utf-8"?>
<!-- اسپلش برند: گرادیان سبز عمیق + آیکون مرکزی تا نخستین رندر وب‌ویو -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient
          android:angle="135"
          android:startColor="#177A67"
          android:centerColor="#0E5A4C"
          android:endColor="#0B3D34"
          android:type="linear"/>
    </shape>
  </item>
  <item android:gravity="center">
    <bitmap
        android:src="@mipmap/ic_launcher_big"
        android:gravity="center"/>
  </item>
</layer-list>
